DATABASE_URL=
REDIS_URL=

AUTH_SECRET=
AUTH_URL=

ENCRYPTION_KEY=
KEY_VERSION=
# Retired keys kept for decrypting old records after rotation: {"v1":"<key>"}
ENCRYPTION_KEYS=

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "true" forces path-style addressing (default when S3_ENDPOINT is set —
# required by MinIO/R2); "false" for virtual-hosted AWS buckets.
S3_FORCE_PATH_STYLE=

LOYVERSE_WEBHOOK_SECRET=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ORG_NAME=

APP_URL=

# Nightly scheduler (issue #33). SCHEDULER_ENABLED=false hands firing to an
# external cron; SCHEDULER_INTERVAL_SECONDS compresses the nightly cycle
# onto a dev timer (first fire at startup, then every N seconds, min 5);
# unset → nightly at NIGHTLY_AT local time (default 02:00), then every 24h.
SCHEDULER_ENABLED=
SCHEDULER_INTERVAL_SECONDS=
NIGHTLY_AT=
